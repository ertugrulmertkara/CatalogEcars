# Bu dosyayı kopyalayıp adını .env yapın ve kendi bilgilerinizi yazın.
# .env dosyası .gitignore'da olduğu için repoya gönderilmez.

# MongoDB Atlas bağlantı adresi
DATABASE_URL=mongodb+srv://kullanici:sifre@cluster0.xxxxx.mongodb.net/veritabani

# JWT token imzalama anahtarı (uzun ve rastgele olmalı; tanımlı değilse sunucu başlamaz)
# Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=uzun-rastgele-bir-anahtar

# Sunucunun çalışacağı port (boş bırakılırsa 3000)
PORT=3000

# createAdmin.js ile oluşturulacak süper yönetici şifresi (en az 8 karakter)
ADMIN_PASSWORD=en-az-8-karakter
